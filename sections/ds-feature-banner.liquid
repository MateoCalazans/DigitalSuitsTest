{%- liquid
  # Is there a photo behind the card?
  assign has_backdrop = false
  if section.settings.backdrop_image != blank or section.settings.backdrop_image_mobile != blank
    assign has_backdrop = true
  endif

  # Either backdrop slot can stand in for the other, so only one is required.
  assign backdrop_desktop = section.settings.backdrop_image | default: section.settings.backdrop_image_mobile
  assign backdrop_mobile = section.settings.backdrop_image_mobile | default: section.settings.backdrop_image

  # A banner at the top of the page is almost always the largest contentful paint.
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  # The card is a flex column, so text alignment also has to drive how children line up.
  case section.settings.text_alignment
    when 'left'
      assign align_items = 'flex-start'
    when 'right'
      assign align_items = 'flex-end'
    else
      assign align_items = 'center'
  endcase

  # How tall the section is. "auto" lets the card's own content decide.
  case section.settings.section_height
    when 'auto'
      assign min_height = 'auto'
    when 'custom'
      assign min_height = section.settings.section_height_custom | append: 'svh'
    when 'full-screen'
      assign min_height = '100svh'
    else
      assign min_height = 'var(--section-height-' | append: section.settings.section_height | append: ')'
  endcase
-%}

<div
  class="
    ds-feature-banner
    {% unless has_backdrop %}ds-feature-banner--no-backdrop{% endunless %}
  "
  style="
    --ds-banner-min-height: {{ min_height }};

    --ds-banner-card-x: {{ section.settings.card_horizontal_position }};
    --ds-banner-card-y: {{ section.settings.card_vertical_position }};
    --ds-banner-card-width: {{ section.settings.card_width }}%;
    --ds-banner-card-width-mobile: {{ section.settings.card_width_mobile }}%;
    --ds-banner-card-inset: {{ section.settings.card_inset }}px;

    --ds-banner-card-bg: {{ section.settings.card_background_color }};
    --ds-banner-card-radius: {{ section.settings.card_corner_radius }}px;
    --ds-banner-card-padding-inline: {{ section.settings.card_padding_inline }}px;
    --ds-banner-card-padding-block: {{ section.settings.card_padding_block }}px;

    --ds-banner-gap: {{ section.settings.content_gap }}px;
    --ds-banner-text-align: {{ section.settings.text_alignment }};
    --ds-banner-align-items: {{ align_items }};
    --ds-banner-card-image-width: {{ section.settings.card_image_width }}%;

    {% comment %} A typed family wins, so a self-hosted face can be used without touching theme settings. {% endcomment %}
    {% if section.settings.heading_font_custom != blank %}
      --ds-banner-heading-font: {{ section.settings.heading_font_custom }};
    {% else %}
      --ds-banner-heading-font: var(--font-{{ section.settings.heading_font }}--family);
    {% endif %}
    --ds-banner-heading-size: {{ section.settings.heading_size }}px;
    --ds-banner-body-size: {{ section.settings.body_size }}px;

    {% if section.settings.heading_color != blank %}--ds-banner-heading-color: {{ section.settings.heading_color }};{% endif %}
    {% if section.settings.body_color != blank %}--ds-banner-body-color: {{ section.settings.body_color }};{% endif %}
    {% if section.settings.eyebrow_color != blank %}--ds-banner-eyebrow-color: {{ section.settings.eyebrow_color }};{% endif %}
    {% if section.settings.button_text_color != blank %}--ds-banner-button-color: {{ section.settings.button_text_color }};{% endif %}
    {% if section.settings.button_background_color != blank %}--ds-banner-button-bg: {{ section.settings.button_background_color }};{% endif %}
    {% if section.settings.overlay_color != blank %}--ds-banner-overlay: {{ section.settings.overlay_color }};{% endif %}

    {% render 'spacing-style', settings: section.settings %}
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  {%- if has_backdrop -%}
    <div class="ds-feature-banner__backdrop">
      {%- if section.settings.backdrop_image != blank and section.settings.backdrop_image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ backdrop_mobile | image_url: width: 1200 }}"
            width="{{ backdrop_mobile.width }}"
            height="{{ backdrop_mobile.height }}"
          >
          {{
            backdrop_desktop
            | image_url: width: 3200
            | image_tag:
              width: backdrop_desktop.width,
              height: backdrop_desktop.height,
              widths: '600, 900, 1200, 1600, 2000, 2600, 3200',
              sizes: '100vw',
              alt: backdrop_desktop.alt,
              class: 'ds-feature-banner__backdrop-image',
              fetchpriority: fetch_priority
          }}
        </picture>
      {%- else -%}
        {{
          backdrop_desktop
          | image_url: width: 3200
          | image_tag:
            width: backdrop_desktop.width,
            height: backdrop_desktop.height,
            widths: '600, 900, 1200, 1600, 2000, 2600, 3200',
            sizes: '100vw',
            alt: backdrop_desktop.alt,
            class: 'ds-feature-banner__backdrop-image',
            fetchpriority: fetch_priority
        }}
      {%- endif -%}

      {%- if section.settings.overlay_color != blank -%}
        <div class="ds-feature-banner__overlay"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ds-feature-banner__layout">
    <div class="ds-feature-banner__card">
      {%- if section.settings.card_image != blank and section.settings.card_image_position == 'top' -%}
        {%- render 'ds-feature-banner-image', image: section.settings.card_image -%}
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="ds-feature-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ds-feature-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="ds-feature-banner__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.card_image != blank and section.settings.card_image_position == 'bottom' -%}
        {%- render 'ds-feature-banner-image', image: section.settings.card_image -%}
      {%- endif -%}

      {%- render 'ds-feature-banner-button', settings: section.settings, section_id: section.id -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ds-feature-banner {
    position: relative;
    display: grid;
    min-height: var(--ds-banner-min-height, auto);
    padding-block-start: var(--padding-block-start, 0);
    padding-block-end: var(--padding-block-end, 0);
  }

  .ds-feature-banner[data-shopify-visual-preview] {
    --ds-banner-min-height: 520px;
  }

  /* --- Backdrop --- */

  .ds-feature-banner__backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ds-feature-banner__backdrop picture {
    display: block;
    height: 100%;
  }

  .ds-feature-banner__backdrop-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ds-feature-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--ds-banner-overlay, transparent);
  }

  /* --- Card placement --- */

  .ds-feature-banner__layout {
    position: relative;
    display: flex;
    justify-content: var(--ds-banner-card-x, flex-end);
    align-items: var(--ds-banner-card-y, stretch);
    min-height: inherit;
    padding: var(--ds-banner-card-inset, 48px);
  }

  .ds-feature-banner__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: var(--ds-banner-align-items, center);
    gap: var(--ds-banner-gap, 40px);
    width: var(--ds-banner-card-width-mobile, 100%);
    padding: var(--ds-banner-card-padding-block, 64px) var(--ds-banner-card-padding-inline, 72px);
    border-radius: var(--ds-banner-card-radius, 0);
    background-color: var(--ds-banner-card-bg, transparent);
    text-align: var(--ds-banner-text-align, center);
  }

  @media screen and (min-width: 750px) {
    .ds-feature-banner__card {
      width: var(--ds-banner-card-width, 45%);
    }
  }

  /* A card with no backdrop behind it has nothing to float over, so let it breathe edge to edge. */
  .ds-feature-banner--no-backdrop .ds-feature-banner__layout {
    padding: 0;
  }

  /* --- Card content --- */

  .ds-feature-banner__card-media {
    width: var(--ds-banner-card-image-width, 48%);
    max-width: 100%;
  }

  .ds-feature-banner__card-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .ds-feature-banner__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ds-banner-eyebrow-color, currentcolor);
  }

  .ds-feature-banner__heading {
    margin: 0;
    font-family: var(--ds-banner-heading-font, var(--font-heading--family));
    /* Scales down on narrow screens but never past the size set in the editor. */
    font-size: clamp(1.75rem, 1.1rem + 2vw, var(--ds-banner-heading-size, 44px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-wrap: balance;
    color: var(--ds-banner-heading-color, currentcolor);
  }

  .ds-feature-banner__body {
    max-width: 46ch;
    /* Arial is specified by the design, so it is pinned here rather than
       following the theme's paragraph token. */
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--ds-banner-body-size, 20px);
    line-height: 1;
    letter-spacing: 0;
    color: var(--ds-banner-body-color, currentcolor);
  }

  .ds-feature-banner__body > :first-child {
    margin-block-start: 0;
  }

  .ds-feature-banner__body > :last-child {
    margin-block-end: 0;
  }

  /* --- Button --- */

  .ds-feature-banner__form {
    display: block;
  }

  .ds-feature-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9375rem 2.25rem;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-buttons-primary, 0);
    /* Matches the body copy, per the design. */
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .ds-feature-banner__button:hover {
    opacity: 0.75;
  }

  .ds-feature-banner__button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ds-feature-banner__button--primary {
    background-color: var(--ds-banner-button-bg, var(--color-foreground));
    color: var(--ds-banner-button-color, var(--color-background));
  }

  .ds-feature-banner__button--secondary {
    background-color: transparent;
    border-color: var(--ds-banner-button-bg, currentcolor);
    color: var(--ds-banner-button-color, currentcolor);
  }

  .ds-feature-banner__button--link {
    padding: 0;
    background-color: transparent;
    color: var(--ds-banner-button-color, currentcolor);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DS Feature banner",
  "tag": "section",
  "class": "ds-feature-banner-wrapper section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Discover The Capri"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>The quest for the perfect sneaker ends right here, with the Capri. It's your day-to-night go to. Keep them box-fresh or let them get scuffed up—you'll love them either way.</p>"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "backdrop_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "backdrop_image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "alpha": true,
      "placeholder": "None"
    },
    {
      "type": "header",
      "content": "Card image"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Image",
      "info": "Shown inside the card, above or below the text."
    },
    {
      "type": "select",
      "id": "card_image_position",
      "label": "Position",
      "options": [
        { "value": "top", "label": "Above text" },
        { "value": "bottom", "label": "Below text" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "card_image_width",
      "label": "Width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop Men"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Action",
      "options": [
        { "value": "link", "label": "Go to a link" },
        { "value": "add_to_cart", "label": "Add a product to cart" }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "visible_if": "{{ section.settings.button_action == 'link' }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false,
      "visible_if": "{{ section.settings.button_action == 'link' }}"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used only when the action is \"Add a product to cart\". The first available variant is added."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "link", "label": "Underlined text" },
        { "value": "primary", "label": "Solid" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.button_style != 'link' }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#8c2a2a"
    },
    {
      "type": "header",
      "content": "Card position"
    },
    {
      "type": "select",
      "id": "card_horizontal_position",
      "label": "Horizontal position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "card_vertical_position",
      "label": "Vertical position",
      "options": [
        { "value": "stretch", "label": "Fill height" },
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "stretch"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 25,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width on mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_inset",
      "label": "Distance from section edge",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Spacing between elements",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "Custom height",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Background",
      "default": "#e3e0db"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "card_padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "heading", "label": "Heading" },
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "text",
      "id": "heading_font_custom",
      "label": "Custom heading font",
      "info": "Optional. A CSS font-family value, for example: \"Kessler Display\", serif. Overrides the font above. The font itself must already be loaded by the theme."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#6e6e6e"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DS Feature banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
